{
  "name": "totalbase",
  "private": true,
  "version": "0.1.0-beta.5",
  "description": "TotalBase - a PostgreSQL-first application platform",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "dev": "bash scripts/dev.sh",
    "dev:server": "pnpm --filter @totalbase/server run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . && pnpm --filter @totalbase/admin run lint",
    "migrate": "pnpm --filter @totalbase/migrations run migrate",
    "test:integration": "bash scripts/test-integration.sh",
    "test:matrix": "bash scripts/test-matrix.sh",
    "test:e2e": "bash scripts/test-e2e.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "eslint": "^10.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^2.1.8"
  }
}
