# TotalBase V1 - Environment configuration
# See specs/Specification.md §14 (Bootstrap) and docs/content/18.reference/05.environment.md
# Copy this file to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# PostgreSQL (required)
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=totalbase
POSTGRES_USER=totalbase
POSTGRES_PASSWORD=
# TLS to PostgreSQL: off (default), require (encrypted, certificate not verified) or verify-full
# (verified against POSTGRES_SSL_CA, a PEM file, else the system authorities). A managed PostgreSQL wants it.
POSTGRES_SSL=off
# POSTGRES_SSL_CA=/path/to/ca.pem

# Dedicated database for integration tests (see scripts/test-integration.sh).
# Must never point at your demo/dev database: tests create and drop tables.
TOTALBASE_TEST_DB=totalbase_test

# ---------------------------------------------------------------------------
# Bootstrap admin (optional, only used while no user holds the Administrators role).
# Unset: the first start logs a link to /admin/setup instead. Development and the
# integration tests use these (the tests sign in with them).
# ---------------------------------------------------------------------------
TOTALBASE_ADMIN_EMAIL=admin@totalbase.local
TOTALBASE_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Master key (optional, at least 32 characters)
# Encrypts totalbase.secrets. Never store this value in PostgreSQL.
# Unset: the first start generates one into $TOTALBASE_DATA_DIR/master.key
# (/var/lib/totalbase by default) - back that file up apart from the database.
# ---------------------------------------------------------------------------
TOTALBASE_MASTER_KEY=

# ---------------------------------------------------------------------------
# Server (optional)
# ---------------------------------------------------------------------------
TOTALBASE_HOST=0.0.0.0
TOTALBASE_PORT=3050

# Development uses this fixed internal port. `pnpm dev` starts the admin
# UI's `nuxt dev` and proxies it through TOTALBASE_PORT, so use only /admin
# on port 3050 in the browser (the App is /admin/app).
TOTALBASE_ADMIN_DEV_PORT=3051
TOTALBASE_API_PROXY_TARGET=http://localhost:3050

# Serves the built apps/admin SPA under /admin/ from this same process
# (set to "false" to run API-only). TOTALBASE_ADMIN_UI_DIR overrides
# where the build lives. TOTALBASE_ADMIN_UI_DEV_PROXY_TARGET is dev-only
# (set automatically by `pnpm dev` / scripts/dev.sh - see AGENTS.md
# section 4B) and normally left unset here.
#TOTALBASE_ADMIN_UI_ENABLED=true
#TOTALBASE_ADMIN_UI_DIR=./admin
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Canonical public URL (optional; default http://localhost:<port>)
# Used while the system.public_url setting is empty (specs/Specification.md §4.2)
# ---------------------------------------------------------------------------
TOTALBASE_PUBLIC_URL=http://localhost:3050
